# Copy this file to `.env.local` and fill in your own values.
# NEVER commit `.env.local` — it is git-ignored.

# --- Public site URL (used for sitemap, Open Graph, canonical URLs) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable / anon key — safe for the browser (used ONLY for admin login).
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Secret / service_role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

# --- Admin dashboard ---
# Only this Supabase Auth user may open /admin and export contacts.
ADMIN_EMAIL=you@example.com
